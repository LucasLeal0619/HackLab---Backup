# Ambiente de testes (APP_ENV=testing). Quando este arquivo existe como .env.testing,
# o Laravel carrega SÓ ele nos testes; o .env não é lido.
#
# Copie para .env.testing e rode: php artisan key:generate --env=testing

APP_NAME=HackLab
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# PostgreSQL EXCLUSIVO de testes (container "postgres" do docker-compose.yml).
# O banco é apagado e recriado pelos testes (RefreshDatabase).
# O nome precisa terminar em _test e o host nunca pode ser do Supabase: o backend recusa.
# Dentro do container, o compose sobrescreve DB_HOST=postgres e DB_PORT=5432.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5442
DB_DATABASE=hacklab_test
DB_USERNAME=hacklab
DB_PASSWORD=hacklab
DB_SEARCH_PATH=hacklab
DB_SSLMODE=disable

EVEN3_ENABLED=false
